# Copy this file to .env and fill in the values.
# Never commit .env.

# Required. Get a key at https://www.weatherapi.com/
WEATHER_API_KEY=

# Leave empty for local development (calls WeatherAPI directly).
# After deploying backend/, set this to the ProxyUrl stack output.
WEATHER_PROXY_URL=

# Shown when geolocation is unavailable or denied.
WEATHER_DEFAULT_CITY=Mumbai
